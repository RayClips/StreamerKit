<Window
    x:Class="StreamerKit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="StreamerKit">

  <Window.SystemBackdrop>
    <MicaBackdrop/>
  </Window.SystemBackdrop>

  <NavigationView x:ConnectionId='2' x:Name="Nav"
                  PaneDisplayMode="Left"
                  IsSettingsVisible="False"
                  IsBackButtonVisible="Collapsed"
                  IsPaneToggleButtonVisible="False"
                  OpenPaneLength="220"
                                                          >

    <!-- Let Mica through: the pane is transparent, and the content sits on a translucent
         layer with a rounded top-left corner, the way Windows 11 Settings does it. -->
    <NavigationView.Resources>
      <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
      <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
      <SolidColorBrush x:Key="NavigationViewContentBackground"
                       Color="{ThemeResource LayerFillColorDefault}"/>
      <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,0,0,0</CornerRadius>
    </NavigationView.Resources>

    <NavigationView.MenuItems>
      <NavigationViewItem Content="Home" Tag="home" IsSelected="True">
        <NavigationViewItem.Icon>
          <SymbolIcon Symbol="Home"/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>

      <NavigationViewItem Content="Servers" Tag="servers">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE968;"/>
        </NavigationViewItem.Icon>
        <NavigationViewItem.InfoBadge>
          <InfoBadge x:ConnectionId='3' x:Name="RunningBadge" Value="0" Visibility="Collapsed"/>
        </NavigationViewItem.InfoBadge>
      </NavigationViewItem>
    </NavigationView.MenuItems>

    <NavigationView.PaneFooter>
      <TextBlock Text="alpha · v0.1.0" Margin="16,0,0,12"
                 Style="{StaticResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
    </NavigationView.PaneFooter>

    <Grid>

      <!-- ===== Home ===== -->
      <ScrollViewer x:ConnectionId='4' x:Name="HomePanel" Padding="0,0,4,0">
        <StackPanel Margin="32,12,36,32" Spacing="14" MaxWidth="1080" HorizontalAlignment="Stretch">

          <Border CornerRadius="8" Padding="28,24" BorderThickness="1"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2E4260" Offset="0"/>
                <GradientStop Color="#26324C" Offset="0.55"/>
                <GradientStop Color="#262B3B" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <StackPanel Spacing="6">
              <TextBlock x:ConnectionId='23' x:Name="Greeting" Style="{StaticResource TitleTextBlockStyle}"/>
              <TextBlock Text="Welcome to StreamerKit"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </Border>

          <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                   Title="Alpha version"
                   Message="Help us improve this tool — if a server won't start or something feels clunky, that's worth reporting."/>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:ConnectionId='20' Grid.Column="0" Style="{StaticResource CardButtonStyle}"                      >
              <StackPanel Spacing="8">
                <FontIcon Glyph="&#xE968;" FontSize="18" HorizontalAlignment="Left"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Servers" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="Start, stop and watch each server" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </Button>

            <Button x:ConnectionId='21' Grid.Column="1" Style="{StaticResource CardButtonStyle}"                   >
              <StackPanel Spacing="8">
                <FontIcon Glyph="&#xE768;" FontSize="18" HorizontalAlignment="Left"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Start all" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="Bring every configured server up" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </Button>

            <Button x:ConnectionId='22' Grid.Column="2" Style="{StaticResource CardButtonStyle}"                  >
              <StackPanel Spacing="8">
                <FontIcon Glyph="&#xE71A;" FontSize="18" HorizontalAlignment="Left"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Stop all" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="Shut everything down cleanly" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock x:ConnectionId='15' x:Name="HomeSummary" Margin="2,0,0,0"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

          <TextBlock Text="Support" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,10,0,0"/>

          <Button x:ConnectionId='16' Style="{StaticResource CardButtonStyle}"                          >
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE939;" FontSize="18" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:ConnectionId='19' x:Name="FeedbackTitle" Text="Help us improve this tool"
                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="Copy a diagnostics summary — versions, status and the last log lines — to paste into a report."
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Grid>
          </Button>

          <Button x:ConnectionId='17' Style="{StaticResource CardButtonStyle}"                     >
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Open the StreamerKit folder" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock x:ConnectionId='18' x:Name="FolderPath" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Grid>
          </Button>

        </StackPanel>
      </ScrollViewer>

      <!-- ===== Servers ===== -->
      <Grid x:ConnectionId='5' x:Name="ServersPanel" Visibility="Collapsed" Margin="32,12,36,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock Text="Servers" Style="{StaticResource TitleTextBlockStyle}"/>
          <TextBlock Text="Start, stop and watch the output of each local server."
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" Padding="0,0,4,0">
          <ItemsControl x:ConnectionId='9' x:Name="ServerList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">

                  <Expander.Header>
                    <Grid ColumnSpacing="14" Padding="0,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                               Fill="{Binding StatusBrush, Mode=OneWay}"/>

                      <StackPanel Grid.Column="1" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding Name, Mode=OneWay}"
                                     Style="{StaticResource BodyStrongTextBlockStyle}"/>
                          <TextBlock Text="{Binding StatusText, Mode=OneWay}" VerticalAlignment="Center"
                                     Style="{StaticResource CaptionTextBlockStyle}"
                                     Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    Visibility="{Binding UrlVisibility, Mode=OneWay}">
                          <HyperlinkButton x:ConnectionId='12' Content="{Binding Url, Mode=OneWay}"
                                                             Padding="0,2" Margin="-2,0,0,0"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                          <Button x:ConnectionId='13' Content="Copy"                   Padding="8,2"
                                  Background="Transparent" BorderThickness="0" FontSize="12"/>
                        </StackPanel>
                      </StackPanel>

                      <Button x:ConnectionId='11' Grid.Column="2" Content="{Binding ActionText, Mode=OneWay}"
                              MinWidth="84"                        VerticalAlignment="Center"/>
                    </Grid>
                  </Expander.Header>

                  <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto">
                    <TextBlock x:ConnectionId='14' Text="{Binding LogText, Mode=OneWay}"
                               FontFamily="Cascadia Mono, Consolas" FontSize="12"
                               IsTextSelectionEnabled="True"                               
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </ScrollViewer>

                </Expander>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
          <TextBlock x:ConnectionId='6' x:Name="Summary" VerticalAlignment="Center"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:ConnectionId='7' Content="Stop all"                  />
            <Button x:ConnectionId='8' Content="Start all" Style="{StaticResource AccentButtonStyle}"                   />
          </StackPanel>
        </Grid>
      </Grid>

    </Grid>
  </NavigationView>
</Window>

