<Window
    x:Class="StreamerKit.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="StreamerKit">

  <Window.SystemBackdrop>
    <MicaBackdrop/>
  </Window.SystemBackdrop>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid.Resources>
      <!-- One card, used for both app servers and hosted servers. Both types expose the
           same property names, so a single template drives them. -->
      <DataTemplate x:Key="ServerCardTemplate">
        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8">

          <Expander.Header>
            <Grid ColumnSpacing="14" Padding="0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                       Fill="{Binding StatusBrush, Mode=OneWay}"/>

              <StackPanel Grid.Column="1" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Name, Mode=OneWay}"
                             Style="{StaticResource BodyStrongTextBlockStyle}"/>
                  <TextBlock Text="{Binding StatusText, Mode=OneWay}" VerticalAlignment="Center"
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel Orientation="Horizontal" Spacing="4"
                            Visibility="{Binding UrlVisibility, Mode=OneWay}">
                  <HyperlinkButton x:ConnectionId='9' Content="{Binding Url, Mode=OneWay}"
                                                     Padding="0,2" Margin="-2,0,0,0"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                  <Button x:ConnectionId='10' Content="Copy"                   Padding="8,2"
                          Background="Transparent" BorderThickness="0" FontSize="12"/>
                </StackPanel>
              </StackPanel>

              <Button x:ConnectionId='8' Grid.Column="2" Content="{Binding ActionText, Mode=OneWay}"
                      MinWidth="84"                        VerticalAlignment="Center"/>
            </Grid>
          </Expander.Header>

          <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto">
            <TextBlock x:ConnectionId='11' Text="{Binding LogText, Mode=OneWay}"
                       FontFamily="Cascadia Mono, Consolas" FontSize="12"
                       IsTextSelectionEnabled="True"                               
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </ScrollViewer>

        </Expander>
      </DataTemplate>
      <!-- One row in the Platforms list: logo beside the name, click to open it. -->
      <DataTemplate x:Key="PlatformRowTemplate">
        <Button x:ConnectionId='6' Style="{StaticResource CardButtonStyle}" Margin="0,0,0,8" Padding="16,13"
                                 >
          <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="28" Height="28" VerticalAlignment="Center">
              <Border CornerRadius="6" Background="{Binding Tile, Mode=OneWay}"
                      Visibility="{Binding InitialVisibility, Mode=OneWay}">
                <TextBlock Text="{Binding Initial, Mode=OneWay}" FontSize="14"
                           FontWeight="SemiBold" Foreground="#FFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Image Source="{Binding IconSource, Mode=OneWay}" Stretch="Uniform"
                     Visibility="{Binding IconVisibility, Mode=OneWay}"/>
            </Grid>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="15"
                         Style="{StaticResource BodyStrongTextBlockStyle}"/>
              <TextBlock Text="{Binding Description, Mode=OneWay}" TextWrapping="Wrap"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Says "this opens something" without needing a button. -->
            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="13" VerticalAlignment="Center"
                      Margin="8,0,2,0"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
          </Grid>
        </Button>
      </DataTemplate>

      <!-- One action in the list. The card isn't a button: it holds three separate
           controls of its own, and nesting those inside one is how you get a toggle
           that also navigates. -->
      <DataTemplate x:Key="ActionCardTemplate">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ToggleSwitch Grid.Column="0" MinWidth="0" OnContent="" OffContent=""
                          VerticalAlignment="Center"
                          IsOn="{Binding Enabled, Mode=TwoWay}"/>

            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="15"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center"/>
                <Border CornerRadius="10" Padding="8,1" VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding GroupVisibility, Mode=OneWay}">
                  <TextBlock Text="{Binding Group, Mode=OneWay}" FontSize="11"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
                <ProgressRing Width="14" Height="14" IsActive="True" VerticalAlignment="Center"
                              Visibility="{Binding RunningVisibility, Mode=OneWay}"/>
              </StackPanel>

              <TextBlock Text="{Binding TriggerSummary, Mode=OneWay}" TextWrapping="Wrap"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding StepSummary, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{Binding LastRunText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
              </StackPanel>
            </StackPanel>

            <Button x:ConnectionId='4' Grid.Column="2" Content="{Binding TestText, Mode=OneWay}" MinWidth="76"
                    VerticalAlignment="Center"                     />

            <Button x:ConnectionId='5' Grid.Column="3" Padding="8" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"                     
                    ToolTipService.ToolTip="Open this action">
              <FontIcon Glyph="&#xE76C;" FontSize="13"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Button>
          </Grid>
        </Border>
      </DataTemplate>

      <!-- A service you could connect to. Used by Integrations. -->
      <DataTemplate x:Key="ConnectCardTemplate">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
          <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="3">
              <!-- Logo sits on the title line, right next to the name. -->
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Grid Width="22" Height="22" VerticalAlignment="Center">
                  <Border CornerRadius="5" Background="{Binding Tile, Mode=OneWay}"
                          Visibility="{Binding InitialVisibility, Mode=OneWay}">
                    <TextBlock Text="{Binding Initial, Mode=OneWay}" FontSize="11.5"
                               FontWeight="SemiBold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Image Source="{Binding IconSource, Mode=OneWay}" Stretch="Uniform"
                         Visibility="{Binding IconVisibility, Mode=OneWay}"/>
                </Grid>
                <TextBlock Text="{Binding Name, Mode=OneWay}" VerticalAlignment="Center"
                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
              </StackPanel>
              <TextBlock Text="{Binding Description, Mode=OneWay}" TextWrapping="Wrap"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="{Binding Requirement, Mode=OneWay}" TextWrapping="Wrap"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                         Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                        VerticalAlignment="Center">
              <TextBlock Text="Not connected" VerticalAlignment="Center"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
              <Button Content="Connect" MinWidth="96" IsEnabled="False"/>
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </Grid.Resources>

    <!-- The app's own title bar. Transparent, so the window backdrop runs straight
         through it; the system only draws the caption buttons on the right. -->
    <Grid x:ConnectionId='12' x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
        <Image x:ConnectionId='148' x:Name="AppIcon" Width="18" Height="18" VerticalAlignment="Center"/>
        <TextBlock x:ConnectionId='149' x:Name="AppTitleText" Text="StreamerKit" VerticalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}"/>
      </StackPanel>
    </Grid>

    <NavigationView x:ConnectionId='13' x:Name="Nav"
                  Grid.Row="1"
                  PaneDisplayMode="Left"
                  IsSettingsVisible="False"
                  IsBackButtonVisible="Collapsed"
                  IsPaneToggleButtonVisible="False"
                  OpenPaneLength="220"
                                                          >

    <!-- Let Mica through: the pane is transparent, and the content sits on a translucent
         layer with a rounded top-left corner, the way Windows 11 Settings does it. -->
    <NavigationView.Resources>
      <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/>
      <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
      <SolidColorBrush x:Key="NavigationViewContentBackground"
                       Color="{ThemeResource LayerFillColorDefault}"/>
      <CornerRadius x:Key="NavigationViewContentGridCornerRadius">8,0,0,0</CornerRadius>
    </NavigationView.Resources>

    <NavigationView.MenuItems>
      <NavigationViewItem Content="Home" Tag="home" IsSelected="True">
        <NavigationViewItem.Icon>
          <SymbolIcon Symbol="Home"/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>

      <NavigationViewItemSeparator/>

      <NavigationViewItem Content="Platforms" Tag="platforms">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE774;"/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>

      <NavigationViewItem Content="Actions" Tag="actions">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE945;"/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>

      <NavigationViewItemSeparator/>

      <NavigationViewItem Content="Servers" Tag="servers">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE968;"/>
        </NavigationViewItem.Icon>
        <NavigationViewItem.InfoBadge>
          <InfoBadge x:ConnectionId='14' x:Name="RunningBadge" Value="0" Visibility="Collapsed"/>
        </NavigationViewItem.InfoBadge>

        <NavigationViewItem.MenuItems>
          <NavigationViewItem Content="App Servers" Tag="appservers">
            <NavigationViewItem.Icon>
              <SymbolIcon Symbol="AllApps"/>
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem Content="HTTP Server" Tag="http">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="&#xE774;"/>
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem Content="WebSocket Server" Tag="websocket">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="&#xE704;"/>
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem Content="UDP Server" Tag="udp">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="&#xE839;"/>
            </NavigationViewItem.Icon>
          </NavigationViewItem>
          <NavigationViewItem Content="Custom" Tag="custom">
            <NavigationViewItem.Icon>
              <FontIcon Glyph="&#xE713;"/>
            </NavigationViewItem.Icon>
          </NavigationViewItem>
        </NavigationViewItem.MenuItems>
      </NavigationViewItem>

      <NavigationViewItem Content="Plugins" Tag="plugins">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE896;"/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>

      <NavigationViewItem Content="Integrations" Tag="integrations">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE71B;"/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.MenuItems>

    <!-- Pinned to the bottom. The built-in settings item always renders last, so these
         are explicit items instead — About has to sit under Settings. -->
    <NavigationView.FooterMenuItems>
      <NavigationViewItem Content="Settings" Tag="settings">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE713;"/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="About" Tag="about">
        <NavigationViewItem.Icon>
          <FontIcon Glyph="&#xE946;"/>
        </NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.FooterMenuItems>

    <NavigationView.PaneFooter>
      <TextBlock Text="alpha · v0.1.0" Margin="16,0,0,12"
                 Style="{StaticResource CaptionTextBlockStyle}"
                 Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
    </NavigationView.PaneFooter>

    <Grid>

      <!-- ===== Home ===== -->
      <ScrollViewer x:ConnectionId='15' x:Name="HomePanel" Padding="0,0,4,0">
        <StackPanel Margin="32,12,36,32" Spacing="14" HorizontalAlignment="Stretch">

          <Border CornerRadius="8" Padding="30,26" BorderThickness="1" MinHeight="164"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4A1F6B" Offset="0"/>
                <GradientStop Color="#2A2143" Offset="0.5"/>
                <GradientStop Color="#12492B" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Image x:ConnectionId='146' x:Name="HomeLogo" Grid.Column="0" Width="92" Height="92"
                     Margin="0,0,24,0" VerticalAlignment="Center"/>

              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="StreamerKit" FontSize="34" Foreground="#FFFFFF"
                           Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock x:ConnectionId='147' x:Name="Greeting" FontSize="16" Foreground="#CFCBDA"/>
              </StackPanel>

              <TextBlock Text="Powered by RayClips" Grid.Column="0" Grid.ColumnSpan="2"
                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Foreground="#9A93AD"
                         Style="{StaticResource CaptionTextBlockStyle}"/>
            </Grid>
          </Border>

          <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                   Title="Alpha version"
                   Message="Help us improve this tool, if a server won't start or something feels clunky, that's worth reporting."/>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:ConnectionId='142' Grid.Column="0" Tag="servers" MinHeight="138"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                    Style="{StaticResource CardButtonStyle}"                   >
              <StackPanel Spacing="8">
                <FontIcon Glyph="&#xE968;" FontSize="20" HorizontalAlignment="Left"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Servers" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="Start, stop and watch each server" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </Button>

            <Button x:ConnectionId='143' Grid.Column="1" Tag="platforms" MinHeight="138"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                    Style="{StaticResource CardButtonStyle}"                   >
              <StackPanel Spacing="8">
                <FontIcon Glyph="&#xE774;" FontSize="20" HorizontalAlignment="Left"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Platforms" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="Read Twitch and Kick chat" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </Button>

            <Button x:ConnectionId='144' Grid.Column="2" Tag="integrations" MinHeight="138"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                    Style="{StaticResource CardButtonStyle}"                   >
              <StackPanel Spacing="8">
                <FontIcon Glyph="&#xE71B;" FontSize="20" HorizontalAlignment="Left"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Integrations" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="Connect OBS to StreamerKit" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </Button>

            <Button x:ConnectionId='145' Grid.Column="3" Tag="actions" MinHeight="138"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Top"
                    Style="{StaticResource CardButtonStyle}"                   >
              <StackPanel Spacing="8">
                <FontIcon Glyph="&#xE945;" FontSize="20" HorizontalAlignment="Left"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="Actions" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="Things that run on their own" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
            </Button>
          </Grid>

          <TextBlock x:ConnectionId='137' x:Name="HomeSummary" Margin="2,0,0,0"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

          <TextBlock Text="Support" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,10,0,0"/>

          <Button x:ConnectionId='138' Style="{StaticResource CardButtonStyle}"                          >
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE939;" FontSize="18" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:ConnectionId='141' x:Name="FeedbackTitle" Text="Help us improve this tool"
                           Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="Copy a diagnostics summary. versions, status and the last log lines to paste into a report."
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Grid>
          </Button>

          <Button x:ConnectionId='139' Style="{StaticResource CardButtonStyle}"                     >
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Open the StreamerKit folder" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock x:ConnectionId='140' x:Name="FolderPath" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </Grid>
          </Button>

        </StackPanel>
      </ScrollViewer>

      <!-- ===== Servers ===== -->
      <Grid x:ConnectionId='16' x:Name="ServersPanel" Visibility="Collapsed" Margin="32,12,36,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock x:ConnectionId='135' x:Name="ServersTitle" Text="Servers" Style="{StaticResource TitleTextBlockStyle}"/>
          <TextBlock x:ConnectionId='136' x:Name="ServersSubtitle"
                     Text="Start, stop and watch the output of each local server."
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" Padding="0,0,4,0">
          <StackPanel>

            <StackPanel x:ConnectionId='130' x:Name="AppServersSection">
              <StackPanel x:ConnectionId='133' x:Name="AppServersHeader">
                <TextBlock Text="App servers" Style="{StaticResource BodyStrongTextBlockStyle}"
                           Margin="2,0,0,2"/>
                <TextBlock Text="Programs on this PC that StreamerKit launches and watches."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,10"/>
              </StackPanel>

              <ItemsControl x:ConnectionId='134' x:Name="ServerList" ItemTemplate="{StaticResource ServerCardTemplate}"/>
            </StackPanel>

            <StackPanel x:ConnectionId='131' x:Name="HostedServersSection">
              <TextBlock Text="Hosted servers" Style="{StaticResource BodyStrongTextBlockStyle}"
                         Margin="2,14,0,2"/>
              <TextBlock Text="Servers StreamerKit runs itself, pick one in the sidebar to configure it."
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,10"/>

              <ItemsControl x:ConnectionId='132' x:Name="HostedList" ItemTemplate="{StaticResource ServerCardTemplate}"/>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
          <TextBlock x:ConnectionId='127' x:Name="Summary" VerticalAlignment="Center"
                     Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:ConnectionId='128' Content="Stop all"                  />
            <Button x:ConnectionId='129' Content="Start all" Style="{StaticResource AccentButtonStyle}"                   />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- ===== Plugins ===== -->
      <Grid x:ConnectionId='17' x:Name="PluginsPanel" Visibility="Collapsed" Margin="32,12,36,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock Text="Plugins" Style="{StaticResource TitleTextBlockStyle}"/>
          <TextBlock Text="Add overlays and integrations to your kit."
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" Padding="0,0,4,0">
          <StackPanel Spacing="10">

            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                     Title="Offline preview"
                     Message="This catalogue is bundled sample data. Nothing is downloaded or installed — the progress bar is simulated, and it resets when you close the app."/>

            <ItemsControl x:ConnectionId='123' x:Name="PluginList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,8">
                    <Grid ColumnSpacing="16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8"
                              Background="{Binding Tile, Mode=OneWay}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Initial, Mode=OneWay}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="#101010"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>

                      <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="{Binding Byline, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Description, Mode=OneWay}" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,3,0,0"/>
                      </StackPanel>

                      <Grid Grid.Column="2" VerticalAlignment="Center" MinWidth="116">
                        <Button x:ConnectionId='125' Content="Get" MinWidth="96" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Right"                        
                                Visibility="{Binding AvailableVisibility, Mode=OneWay}"/>

                        <StackPanel Spacing="6" VerticalAlignment="Center"
                                    Visibility="{Binding InstallingVisibility, Mode=OneWay}">
                          <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Width="96"/>
                          <TextBlock Text="{Binding ProgressText, Mode=OneWay}"
                                     HorizontalAlignment="Center"
                                     Style="{StaticResource CaptionTextBlockStyle}"
                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                                    Visibility="{Binding InstalledVisibility, Mode=OneWay}">
                          <FontIcon Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center"
                                    Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                          <TextBlock Text="Installed" VerticalAlignment="Center"
                                     Style="{StaticResource CaptionTextBlockStyle}"/>
