                  <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                           Fill="{Binding StatusBrush, Mode=OneWay}"/>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Status"/>
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                  <Button x:ConnectionId='119' Grid.Column="2" Content="{Binding ActionText, Mode=OneWay}" MinWidth="110"
                          Style="{StaticResource AccentButtonStyle}"                     />
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Connect when StreamerKit starts"/>
                    <TextBlock Text="Starts reading this chat on launch, and brings the WebSocket server up with it. Needs a channel name set above."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoConnect, Mode=TwoWay}"/>
                </Grid>
              </Border>

              <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                       Message="Chat messages only, read-only, no account needed. Follows, subs, bits and raids need OAuth, which isn't built yet."/>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ===== Actions ===== -->
      <Grid x:ConnectionId='20' x:Name="ActionsPanel" Visibility="Collapsed" Margin="32,12,36,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <StackPanel Spacing="4">
            <TextBlock Text="Actions" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Things that happen on their own when something else does."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button x:ConnectionId='114'                        
                    ToolTipService.ToolTip="Save every action to a file">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE898;" FontSize="14"/>
                <TextBlock Text="Export"/>
              </StackPanel>
            </Button>
            <Button x:ConnectionId='115'                        
                    ToolTipService.ToolTip="Add actions from a file, without replacing these">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE896;" FontSize="14"/>
                <TextBlock Text="Import"/>
              </StackPanel>
            </Button>
            <Button x:ConnectionId='116' Content="New action" Style="{StaticResource AccentButtonStyle}"
                                       />
          </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" Padding="0,0,4,0">
          <StackPanel Spacing="10">

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="What can start an action"
                     Message="Chat commands and messages, a timer, one of your servers changing state, or an overlay calling it over the WebSocket server. Follows, subs, bits and raids need OAuth, which isn't built yet."/>
               

            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                     Title="Some actions can include custom C#, please review the action before using it" />

            <ItemsControl x:ConnectionId='112' x:Name="ActionList" ItemTemplate="{StaticResource ActionCardTemplate}"/>

            <TextBlock x:ConnectionId='113' x:Name="NoActions" Visibility="Collapsed" Margin="2,8,0,0"
                       Text="No actions yet. Press New action to make one."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ===== One action, opened from the list ===== -->
      <Grid x:ConnectionId='21' x:Name="ActionDetailPanel" Visibility="Collapsed" Margin="32,12,36,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="10">
          <Button x:ConnectionId='107'                         Padding="8,4" HorizontalAlignment="Left"
                  Background="Transparent" BorderThickness="0">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE72B;" FontSize="13"/>
              <TextBlock Text="Actions" Style="{StaticResource CaptionTextBlockStyle}"/>
            </StackPanel>
          </Button>

          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Committed on focus loss, not per keystroke: every commit writes actions.json. -->
            <TextBox Grid.Column="0" FontSize="22" VerticalAlignment="Center"
                     Background="Transparent" BorderThickness="0" Padding="0,2"
                     PlaceholderText="Action name"
                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
              <ToggleSwitch MinWidth="0" OnContent="On" OffContent="Off" VerticalAlignment="Center"
                            IsOn="{Binding Enabled, Mode=TwoWay}"/>
              <Button x:ConnectionId='108' Content="{Binding TestText, Mode=OneWay}" MinWidth="80"                     />
              <Button Padding="9,6" ToolTipService.ToolTip="More">
                <FontIcon Glyph="&#xE712;" FontSize="14"/>
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem x:ConnectionId='109' Text="Duplicate"                          />
                    <MenuFlyoutItem x:ConnectionId='110' Text="Clear log"                         />
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:ConnectionId='111' Text="Delete"                       />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
          </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" Padding="0,0,4,0">
          <StackPanel Spacing="10">

            <Border Style="{StaticResource SettingsCard}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Group"/>
                  <TextBlock Text="Optional label to keep related actions together."
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <TextBox Grid.Column="1" MinWidth="200" PlaceholderText="none"
                         VerticalAlignment="Center"
                         Text="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
              </Grid>
            </Border>

            <!-- Triggers -->
            <Grid Margin="2,10,0,0">
              <StackPanel Spacing="2">
                <TextBlock Text="Triggers" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="Any one of these starts the action."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <Button x:ConnectionId='106' x:Name="AddTriggerButton" Content="Add trigger" HorizontalAlignment="Right"
                      VerticalAlignment="Center"/>
            </Grid>

            <StackPanel x:ConnectionId='100' x:Name="TriggerBlocks" Spacing="8"/>

            <TextBlock x:ConnectionId='101' x:Name="NoTriggers" Visibility="Collapsed" Margin="2,0,0,0"
                       Text="No triggers. The action can still be run with the Test button."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- Steps -->
            <Grid Margin="2,14,0,0">
              <StackPanel Spacing="2">
                <TextBlock Text="Steps" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="Run in order, top to bottom. If one fails the rest are skipped."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <Button x:ConnectionId='105' x:Name="AddStepButton" Content="Add step" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"/>
