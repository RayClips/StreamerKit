              <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
