                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Bot token" Style="{StaticResource CaptionTextBlockStyle}"/>
                    <PasswordBox x:ConnectionId='73' x:Name="DiscordTokenBox" Password="{Binding Token, Mode=TwoWay}"
                                 IsEnabled="{Binding IsEditable, Mode=OneWay}"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Read message text"/>
                    <TextBlock Text="Needs the Message Content intent, which is off by default. Without it the bot still sees that a message happened, but its text arrives empty."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsOn="{Binding ReadMessages, Mode=TwoWay}"
                                IsEnabled="{Binding IsEditable, Mode=OneWay}"/>
                </Grid>
              </Border>

              <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                       Title="Where these come from"
                       Message="Discord Developer Portal, your application: the id is on General Information, the token on Bot (it is shown once, and resetting it invalidates the old one). Turn on Bot, Privileged Gateway Intents, Message Content to read what people type."/>

              <TextBlock Text="Invite the bot" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,10,0,0"/>
              <TextBlock Text="A bot can only read and post in servers it has been added to. This link asks for exactly what StreamerKit uses: view channels, send messages and embeds, attach files, read history."
                         Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,4"/>

              <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding InviteUrl, Mode=OneWay}"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                  <Button x:ConnectionId='72' Grid.Column="1" Content="Copy"                            />
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                           Fill="{Binding StatusBrush, Mode=OneWay}"/>
                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Status"/>
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                  <Button x:ConnectionId='71' Grid.Column="2" Content="{Binding ActionText, Mode=OneWay}" MinWidth="110"
                          Style="{StaticResource AccentButtonStyle}"                        />
                </Grid>
              </Border>

              <Border Style="{StaticResource SettingsCard}">
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Connect when StreamerKit starts"/>
                    <TextBlock Text="Signs the bot in on launch. Needs a bot token set above."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoConnect, Mode=TwoWay}"/>
                </Grid>
              </Border>

              <TextBlock Text="Try it" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,10,0,0"/>
              <TextBlock Text="Channel ids come from Discord itself: turn on Advanced, Developer Mode, then right-click a channel and Copy Channel ID."
                         Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,4"/>

              <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="12">
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:ConnectionId='68' x:Name="DiscordChannelBox" Grid.Column="0" MinWidth="220"
                             PlaceholderText="Channel id"/>
                    <TextBox x:ConnectionId='69' x:Name="DiscordMessageBox" Grid.Column="1"
                             PlaceholderText="Message to send"/>
                    <Button x:ConnectionId='70' Grid.Column="2" Content="Send"                             />
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:ConnectionId='65' Content="Who am I" Tag="users/@me"                       />
                    <Button x:ConnectionId='66' Content="My servers" Tag="users/@me/guilds"                       />
                    <Button x:ConnectionId='67' Content="Clear log"                          />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource SettingsCard}">
                <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Auto">
                  <TextBlock x:ConnectionId='64' Text="{Binding LogText, Mode=OneWay}"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             IsTextSelectionEnabled="True"                               
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </ScrollViewer>
              </Border>

            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ===== Custom WebSocket servers and clients ===== -->
      <Grid x:ConnectionId='24' x:Name="CustomPanel" Visibility="Collapsed" Margin="32,12,36,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock Text="Custom" Style="{StaticResource TitleTextBlockStyle}"/>
          <TextBlock Text="Your own WebSocket servers, and outbound connections to other people's."
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" Padding="0,0,4,0">
          <StackPanel Spacing="8">

            <!-- Servers -->
            <Grid Margin="2,0,0,2">
              <TextBlock Text="Servers" Style="{StaticResource BodyStrongTextBlockStyle}"
                         VerticalAlignment="Center"/>
              <Button x:ConnectionId='59' Content="Add server" HorizontalAlignment="Right"                          />
            </Grid>
            <TextBlock x:ConnectionId='48' x:Name="NoCustomServers" Text="None yet." Margin="2,0,0,6"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

            <ItemsControl x:ConnectionId='49' x:Name="CustomServerList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,8">
                    <StackPanel Spacing="12">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{Binding StatusBrush, Mode=OneWay}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding StatusText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:ConnectionId='57' Grid.Column="2" Content="{Binding ActionText, Mode=OneWay}" MinWidth="86"
                                                      />
                        <Button x:ConnectionId='58' Grid.Column="3" Content="Remove"                             />
                      </Grid>

                      <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                          <TextBlock Text="Name" Style="{StaticResource CaptionTextBlockStyle}"/>
                          <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   IsEnabled="{Binding IsEditable, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                          <TextBlock Text="Address" Style="{StaticResource CaptionTextBlockStyle}"/>
                          <TextBox Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   IsEnabled="{Binding IsEditable, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                          <TextBlock Text="Port" Style="{StaticResource CaptionTextBlockStyle}"/>
                          <NumberBox Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact"
                                     Value="{Binding PortValue, Mode=TwoWay}"
                                     IsEnabled="{Binding IsEditable, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                          <TextBlock Text="Endpoint" Style="{StaticResource CaptionTextBlockStyle}"/>
                          <TextBox Text="{Binding EndpointPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   IsEnabled="{Binding IsEditable, Mode=OneWay}"/>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Clients -->
            <Grid Margin="2,14,0,2">
              <TextBlock Text="Clients" Style="{StaticResource BodyStrongTextBlockStyle}"
                         VerticalAlignment="Center"/>
              <Button x:ConnectionId='55' Content="Add client" HorizontalAlignment="Right"                          />
            </Grid>
            <TextBlock x:ConnectionId='50' x:Name="NoCustomClients" Text="None yet." Margin="2,0,0,6"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>

            <ItemsControl x:ConnectionId='51' x:Name="CustomClientList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,8">
                    <StackPanel Spacing="12">
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                 Fill="{Binding StatusBrush, Mode=OneWay}"/>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   Text="{Binding StatusText, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:ConnectionId='53' Grid.Column="2" Content="{Binding ActionText, Mode=OneWay}" MinWidth="106"
                                                            />
                        <Button x:ConnectionId='54' Grid.Column="3" Content="Remove"                             />
                      </Grid>

                      <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                          <TextBlock Text="Name" Style="{StaticResource CaptionTextBlockStyle}"/>
                          <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   IsEnabled="{Binding IsEditable, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                          <TextBlock Text="Endpoint" Style="{StaticResource CaptionTextBlockStyle}"/>
                          <TextBox Text="{Binding Endpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                   IsEnabled="{Binding IsEditable, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                          <TextBlock Text="Retry interval (seconds)"
                                     Style="{StaticResource CaptionTextBlockStyle}"/>
                          <NumberBox Minimum="1" Maximum="3600" SpinButtonPlacementMode="Compact"
                                     Value="{Binding RetryValue, Mode=TwoWay}"
                                     IsEnabled="{Binding IsEditable, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                          <TextBlock Text="TLS (wss)" Style="{StaticResource CaptionTextBlockStyle}"/>
                          <ToggleSwitch IsOn="{Binding Tls, Mode=TwoWay}" MinWidth="0"
                                        IsEnabled="{Binding IsEditable, Mode=OneWay}"/>
                        </StackPanel>
                      </Grid>

                      <TextBlock Text="{Binding EffectiveUrl, Mode=OneWay}"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                 Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ===== One hosted server, in detail ===== -->
      <ScrollViewer x:ConnectionId='25' x:Name="DetailPanel" Visibility="Collapsed" Padding="0,0,4,0">
        <StackPanel Margin="32,12,36,32" Spacing="8">

          <StackPanel Spacing="4" Margin="0,0,0,6">
            <TextBlock Text="{Binding Name, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
          </StackPanel>

          <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                   Message="Settings can only be changed while the server is stopped."
                   Visibility="{Binding UrlVisibility, Mode=OneWay}"/>

          <!-- Auto start -->
          <Border Style="{StaticResource SettingsCard}">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Auto Start"/>
                <TextBlock Text="Automatically start this server when StreamerKit starts up"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" MinWidth="0" IsOn="{Binding AutoStart, Mode=TwoWay}"/>
            </Grid>
          </Border>

          <!-- Address -->
          <Border Style="{StaticResource SettingsCard}">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Address"/>
                <TextBlock Text="The IP address for this server to bind to. For example, '127.0.0.1'"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <TextBox Grid.Column="1" MinWidth="180" Text="{Binding Address, Mode=TwoWay}"
                       IsEnabled="{Binding IsEditable, Mode=OneWay}" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- Port -->
          <Border Style="{StaticResource SettingsCard}">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Port"/>
                <TextBlock Text="The port to use for server connections"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <NumberBox Grid.Column="1" MinWidth="180" Minimum="1" Maximum="65535"
                         SpinButtonPlacementMode="Compact"
                         Value="{Binding PortValue, Mode=TwoWay}"
                         IsEnabled="{Binding IsEditable, Mode=OneWay}" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- Endpoint -->
          <Border Style="{StaticResource SettingsCard}"
                  Visibility="{Binding EndpointVisibility, Mode=OneWay}">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Endpoint"/>
                <TextBlock Text="The path this server listens on"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <TextBox Grid.Column="1" MinWidth="180" Text="{Binding EndpointPath, Mode=TwoWay}"
                       IsEnabled="{Binding IsEditable, Mode=OneWay}" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <!-- Authentication -->
          <Border Style="{StaticResource SettingsCard}"
                  Visibility="{Binding AuthVisibility, Mode=OneWay}">
            <StackPanel Spacing="12">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Authentication"/>
                  <TextBlock Text="Whether this server requires a token to connect"
                             Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" MinWidth="0" IsOn="{Binding Authentication, Mode=TwoWay}"
                              IsEnabled="{Binding IsEditable, Mode=OneWay}"/>
              </Grid>

              <Grid ColumnSpacing="16" Visibility="{Binding TokenVisibility, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Token"/>
                  <TextBlock Text="Clients connect with ?token=… appended to the URL"
                             Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <TextBox MinWidth="180" Text="{Binding Token, Mode=TwoWay}"
                           IsEnabled="{Binding IsEditable, Mode=OneWay}" VerticalAlignment="Center"/>
                  <Button x:ConnectionId='47' Content="Generate"                         VerticalAlignment="Center"
                          IsEnabled="{Binding IsEditable, Mode=OneWay}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Status -->
          <Border Style="{StaticResource SettingsCard}">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                       Fill="{Binding StatusBrush, Mode=OneWay}"/>
              <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Server Status"/>
                <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:ConnectionId='44' Content="Send test message"                          
                        Visibility="{Binding TestMessageVisibility, Mode=OneWay}"/>
                <Button x:ConnectionId='45' Content="Copy URL"                  
                        Visibility="{Binding UrlVisibility, Mode=OneWay}"/>
                <Button x:ConnectionId='46' Content="{Binding ActionText, Mode=OneWay}" MinWidth="84"
                        Style="{StaticResource AccentButtonStyle}"                       />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Connected clients -->
          <Border Style="{StaticResource SettingsCard}"
                  Visibility="{Binding ClientsVisibility, Mode=OneWay}">
            <StackPanel Spacing="8">
              <TextBlock Text="Connected Clients"/>
              <TextBlock Text="Clients that are currently connected"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="Nothing connected." Margin="0,4,0,0"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                         Visibility="{Binding NoClientsVisibility, Mode=OneWay}"/>
              <ItemsControl ItemsSource="{Binding Clients, Mode=OneWay}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Remote}"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                      <TextBlock Grid.Column="1" Text="{Binding Since}"
                                 Style="{StaticResource CaptionTextBlockStyle}"
                                 Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Log -->
          <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="8">
              <TextBlock Text="Log"/>
              <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:ConnectionId='42' Text="{Binding LogText, Mode=OneWay}"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12"
                           IsTextSelectionEnabled="True"                               
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </ScrollViewer>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- ===== About ===== -->
      <ScrollViewer x:ConnectionId='26' x:Name="AboutPanel" Visibility="Collapsed" Padding="0,0,4,0">
        <StackPanel Margin="32,12,36,32" Spacing="14">

          <StackPanel Orientation="Horizontal" Spacing="18">
            <Image x:ConnectionId='40' x:Name="AboutIcon" Width="64" Height="64" VerticalAlignment="Top"/>
            <StackPanel Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="StreamerKit" Style="{StaticResource TitleTextBlockStyle}"/>
              <TextBlock x:ConnectionId='41' x:Name="AboutVersion"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </StackPanel>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="8">
              <TextBlock Text="What it does" Style="{StaticResource BodyStrongTextBlockStyle}"/>
              <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         Text="StreamerKit runs the local servers behind your OBS overlays. Instead of a black console window per tool, every server sits in one list: start and stop with a click, copy the URL straight into a Browser Source, and watch the output when you need it. If a server crashes it gets logged and restarted, and nothing is left running when you close the app."/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="8">
              <TextBlock Text="Servers" Style="{StaticResource BodyStrongTextBlockStyle}"/>
              <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         Text="App servers are programs on this PC that StreamerKit launches and supervises. Hosted servers — HTTP, WebSocket and UDP — run inside StreamerKit itself, so there is nothing to install and nothing to keep alive separately."/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <StackPanel Spacing="6">
              <TextBlock Text="Build" Style="{StaticResource BodyStrongTextBlockStyle}"/>
              <TextBlock x:ConnectionId='39' x:Name="AboutBuild" TextWrapping="Wrap"
                         Style="{StaticResource CaptionTextBlockStyle}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource SettingsCard}">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Alpha software"/>
                <TextBlock Text="Rough edges are expected. Copy a diagnostics summary to report one."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <Button x:ConnectionId='38' Grid.Column="1" Content="Copy diagnostics"                          
                      VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <TextBlock Text="Made by AerisVisuals" Style="{StaticResource CaptionTextBlockStyle}"
                     Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="2,0,0,0"/>

        </StackPanel>
      </ScrollViewer>

      <!-- ===== Settings ===== -->
      <Grid x:ConnectionId='27' x:Name="SettingsPanel" Visibility="Collapsed" Margin="32,12,36,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>
          <TextBlock Text="Startup, appearance and server behaviour."
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" Padding="0,0,4,0">
          <!-- No MaxWidth here. MaxWidth + Stretch centres the panel once the window is
               wider than the max, which pulls these cards away from the page title. -->
          <StackPanel Spacing="8" HorizontalAlignment="Stretch">

            <TextBlock Text="Startup" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,4,0,2"/>

            <Border Style="{StaticResource SettingsCard}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE7E8;" FontSize="18" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Start StreamerKit when I sign in"/>
                  <TextBlock Text="Adds a Run entry for the current user. Nothing else on the system is touched."
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch x:ConnectionId='37' x:Name="StartWithWindows" Grid.Column="2" MinWidth="0"
                                                                 />
              </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE7B5;" FontSize="18" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Open on"/>
                  <TextBlock Text="Which page StreamerKit shows when it starts."
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ComboBox x:ConnectionId='36' x:Name="StartPageBox" Grid.Column="2" MinWidth="150"
                                                               >
                  <ComboBoxItem Content="Home" Tag="home"/>
                  <ComboBoxItem Content="Servers" Tag="servers"/>
                  <ComboBoxItem Content="Plugins" Tag="plugins"/>
                </ComboBox>
              </Grid>
            </Border>

            <TextBlock Text="Reliability" Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="2,12,0,2"/>

            <Border Style="{StaticResource SettingsCard}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE72C;" FontSize="18" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Restart a server if it crashes"/>
                  <TextBlock Text="Up to 5 times with a growing delay, then it stops and waits for you. Every crash is written to crashes.log."
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch x:ConnectionId='35' x:Name="AutoRestartSwitch" Grid.Column="2" MinWidth="0"
                                                            />
              </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE9F9;" FontSize="18" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Crash log"/>
                  <TextBlock x:ConnectionId='34' x:Name="CrashLogText"
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:ConnectionId='33' Grid.Column="2" Content="Open"                       />
              </Grid>
            </Border>

            <TextBlock Text="Auto-start servers" Style="{StaticResource BodyStrongTextBlockStyle}"
                       Margin="2,12,0,2"/>
            <TextBlock Text="These start on their own as soon as StreamerKit opens. Saved to servers.json."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,2"/>

            <ItemsControl x:ConnectionId='28' x:Name="AutoStartList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,8">
                    <Grid ColumnSpacing="16">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                               Fill="{Binding StatusBrush, Mode=OneWay}"/>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name, Mode=OneWay}"/>
                        <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                      </StackPanel>
                      <ToggleSwitch x:ConnectionId='32' Grid.Column="2" MinWidth="0" IsOn="{Binding AutoStart, Mode=OneWay}"
                                                                />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,12,0,2"/>

            <Border Style="{StaticResource SettingsCard}">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="18" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="App theme"/>
                  <TextBlock Text="Applies immediately."
                             Style="{StaticResource CaptionTextBlockStyle}"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <ComboBox x:ConnectionId='30' x:Name="ThemeBox" Grid.Column="2" MinWidth="150"                                  >
                  <ComboBoxItem Content="Use system setting" Tag="system"/>
                  <ComboBoxItem Content="Light" Tag="light"/>
                  <ComboBoxItem Content="Dark" Tag="dark"/>
                </ComboBox>
              </Grid>
            </Border>

            <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,12,0,2"/>

            <Border Style="{StaticResource SettingsCard}">
              <StackPanel Spacing="3">
                <TextBlock Text="StreamerKit" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock x:ConnectionId='29' x:Name="AboutText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Grid>

      </Grid>
    </NavigationView>
  </Grid>
</Window>

