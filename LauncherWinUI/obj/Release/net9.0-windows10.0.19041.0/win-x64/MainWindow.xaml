              <Border Style="{StaticResource SettingsCard}">
                <ScrollViewer MaxHeight="340" HorizontalScrollBarVisibility="Auto">
                  <TextBlock x:ConnectionId='74' Text="{Binding LogText, Mode=OneWay}"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12"
