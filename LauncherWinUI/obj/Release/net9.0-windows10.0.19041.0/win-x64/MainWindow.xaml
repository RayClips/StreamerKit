                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,4"/>

              <Border Style="{StaticResource SettingsCard}">
                <StackPanel Spacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:ConnectionId='90' Content="Version" Tag="GetVersion"                   />
                    <Button x:ConnectionId='91' Content="Scenes" Tag="GetSceneList"                   />
                    <Button x:ConnectionId='92' Content="Inputs" Tag="GetInputList"                   />
                    <Button x:ConnectionId='93' Content="Input kinds" Tag="GetInputKindList"                   />
                    <Button x:ConnectionId='94' Content="Stream status" Tag="GetStreamStatus"                   />
                    <Button x:ConnectionId='95' Content="Stats" Tag="GetStats"                   />
                    <Button x:ConnectionId='96' Content="Hotkeys" Tag="GetHotkeyList"                   />
                  </StackPanel>

