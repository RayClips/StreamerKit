            <StackPanel x:ConnectionId='102' x:Name="StepBlocks" Spacing="8"/>

            <TextBlock x:ConnectionId='103' x:Name="NoSteps" Visibility="Collapsed" Margin="2,0,0,0"
                       Text="No steps yet. An action with no steps never does anything."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- Log -->
            <Expander Margin="0,14,0,0" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
              <Expander.Header>
                <TextBlock Text="Log" Style="{StaticResource BodyStrongTextBlockStyle}"/>
              </Expander.Header>
              <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <TextBlock x:ConnectionId='104' Text="{Binding LogText, Mode=OneWay}" FontFamily="Consolas"
                           FontSize="12" TextWrapping="NoWrap" IsTextSelectionEnabled="True"
                                                         
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              </ScrollViewer>
            </Expander>

          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- ===== Integrations ===== -->
      <Grid x:ConnectionId='22' x:Name="IntegrationsPanel" Visibility="Collapsed" Margin="32,12,36,20">
